// senseforge_addon.rc.in — SF-14: VERSIONINFO for the ReShade add-on
// (ReShade's Add-ons list shows FileVersion; it read "v0.0.0.0" before).
// Configured by CMake into the build tree.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SENSEFORGE_MOD_VERSION_MAJOR@,@SENSEFORGE_MOD_VERSION_MINOR@,@SENSEFORGE_MOD_VERSION_PATCH@,0
 PRODUCTVERSION @SENSEFORGE_MOD_VERSION_MAJOR@,@SENSEFORGE_MOD_VERSION_MINOR@,@SENSEFORGE_MOD_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SenseForge"
            VALUE "FileDescription", "SenseForge DualSense runtime (@SENSEFORGE_GAME_NAME@)"
            VALUE "FileVersion", "@SENSEFORGE_MOD_VERSION@"
            VALUE "InternalName", "senseforge.@SENSEFORGE_GAME_SLUG@"
            VALUE "OriginalFilename", "senseforge.@SENSEFORGE_GAME_SLUG@.addon64"
            VALUE "ProductName", "SenseForge"
            VALUE "ProductVersion", "@SENSEFORGE_MOD_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
